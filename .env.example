# Local development defaults. Never commit real credentials.
# Use a persistent volume path in production (Railway: /data/mpie.sqlite3).
MPIE_DATABASE_PATH=./data/mpie.sqlite3
MPIE_LOG_LEVEL=INFO
MPIE_MODE=research

# Leave blank locally. Production mode requires a strong value (32+ characters).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MPIE_API_KEY=
