# Local development defaults. Never commit real credentials.
# Local-first SQLite database path.
MPIE_DATABASE_PATH=./data/mpie.sqlite3
MPIE_LOG_LEVEL=INFO
MPIE_MODE=research

# Only needed if deploying the Python API in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MPIE_API_KEY=
